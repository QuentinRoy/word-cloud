{
	"name": "@quentinroy/word-cloud",
	"private": false,
	"version": "0.13.1",
	"description": "Interactive word cloud custom element powered by Matter.js",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/QuentinRoy/word-cloud.git"
	},
	"homepage": "https://github.com/QuentinRoy/word-cloud",
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc -p tsconfig.lib.json && tsc -p tsconfig.node.json",
		"build:demo": "vite build --mode demo",
		"preview": "vite preview --mode demo",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest --config vitest.config.ts --run",
		"test:watch": "vitest --config vitest.config.ts",
		"release": "pnpm run build && changeset publish",
		"changeset": "changeset"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@changesets/cli": "^2.31.0",
		"@types/html-minifier-terser": "^7.0.2",
		"@types/matter-js": "^0.20.2",
		"@types/node": "^25.9.3",
		"@vitest/browser": "^4.1.8",
		"@vitest/browser-playwright": "^4.1.8",
		"arktype": "^2.2.0",
		"cssnano": "^8.0.2",
		"cssnano-preset-default": "^8.0.2",
		"html-minifier-terser": "^7.2.0",
		"playwright": "^1.60.0",
		"postcss": "^8.5.15",
		"type-fest": "^5.7.0",
		"typescript": "~6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@quentinroy/custom-element-mixins": "npm:@jsr/quentinroy__custom-element-mixins@^0.4.1",
		"matter-js": "^0.20.0"
	}
}
