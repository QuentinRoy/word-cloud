{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"files": {
		"includes": ["**", "!**/dist", "!**/node_modules", "!**/dist-demo"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"useConst": "off",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"matter-js": {
								"allowImportNames": ["default"],
								"message": "Use `import Matter from \"matter-js\"` and access APIs as `Matter.Body`, `Matter.Vector`, etc. Named imports are incompatible with the externalized CDN build."
							}
						}
					}
				}
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"useSortedProperties": "on"
			}
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"trailingCommas": "all",
			"semicolons": "asNeeded",
			"arrowParentheses": "always",
			"expand": "never"
		}
	},
	"html": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"selfCloseVoidElements": "never"
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		}
	}
}
